# HeyGen API key (Settings -> API in app.heygen.com). Required for `render`.
HEYGEN_API_KEY=
# Optional: Claude API key. If set, scripts are written by Claude instead of the template engine.
ANTHROPIC_API_KEY=
# Directory holding per-channel YouTube OAuth tokens (see README "YouTube setup").
OTD_SECRETS_DIR=secrets
# Working directory for plans, rendered videos and the job database.
OTD_DATA_DIR=data

# Renderer: heygen (default) or hedra.
OTD_RENDERER=heygen
# Hedra (only when OTD_RENDERER=hedra). Portraits go in $OTD_SECRETS_DIR/portraits/<channel_key>.jpg
HEDRA_API_KEY=
HEDRA_VOICE_ID=
HEDRA_RESOLUTION=540p

# Free local renderer (OTD_RENDERER=local): no keys needed. Optional extras:
PEXELS_API_KEY=          # free key -> portrait stock b-roll instead of the gradient
OTD_MUSIC_DIR=           # folder of mp3s mixed under the voice at 10% volume
OTD_CAPTION_FONT=DejaVu Sans
OTD_TTS=edge             # edge (free, online) | piper (free, offline, needs OTD_PIPER_MODEL) | fake (tests)
OTD_PIPER_MODEL=
